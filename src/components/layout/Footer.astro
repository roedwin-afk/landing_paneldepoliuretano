---
import NavLinks from "../ui/NavLinks.astro";
import { Mail, MapPin } from "lucide-astro";
import { texts } from "../../content/texts";
import { Image } from "astro:assets";

import logo from "../../assets/logo.svg";

const { footer } = texts;
---

<footer class="footer">
  <div class="container footer__inner">
    <!-- Columna 1: Marca -->
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <!-- PANEL<span class="footer__logo--accent">DE</span>POLIURETANO<span
          class="footer__logo--muted">.com</span
        > -->
        <Image
          src={logo}
          alt="Panel sándwich para techo industrial"
          width={200}
          height={50}
          class="footer__logo-img"
          format="webp"
          quality={85}
          loading="eager"
        />
      </a>
      <p class="footer__description">{footer.description}</p>
    </div>

    <!-- Columna 2: Navegación -->
    <div class="footer__nav">
      <h4 class="footer__heading">Navegación</h4>
      <NavLinks variant="footer" />
    </div>

    <!-- Columna 4: Contacto -->
    <div class="footer__contact">
      <h4 class="footer__heading">{footer.contactTitle}</h4>
      <ul class="footer__list">
        <li class="footer__contact-item">
          <Mail size={14} />
          <a href={"mailto:" + footer.email} class="footer__link">
            {footer.email}
          </a>
        </li>
        <li class="footer__contact-item">
          <MapPin size={14} />
          <a
            href={footer.googleMapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="footer__link"
          >
            {footer.support}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright" id="footer-copyright">
        © <span id="copyright-year"></span> paneldepoliuretano.com - Todos los derechos
        reservados.
      </p>
    </div>
  </div>
</footer>

<script>
  document.getElementById("copyright-year")!.textContent = new Date()
    .getFullYear()
    .toString();
</script>

<style>
  .footer {
    background-color: var(--color-dark);
    color: var(--color-dark-muted);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-12);
  }

  /* Logo */
  .footer__logo {
    display: inline-block;
    margin-bottom: var(--space-4);
    transition: var(--transition);
  }

  .footer__logo:hover {
    opacity: 0.8;
  }

  .footer__logo-img {
    display: block;
    height: 2.5rem;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__description {
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 20rem;
  }

  /* Headings */
  .footer__heading {
    font-size: var(--text-sm);
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  /* Lists */
  .footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: var(--color-dark-muted);
    transition: var(--transition);
  }

  .footer__link:hover {
    color: white;
  }

  /* Contact items */
  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .footer__contact-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-accent);
  }

  /* Bottom bar */
  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.08);
    padding-block: var(--space-6);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Responsive */
  @media (min-width: 640px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .footer__brand {
      grid-column: auto;
    }
  }
</style>
