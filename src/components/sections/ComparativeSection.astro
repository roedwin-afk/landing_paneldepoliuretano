---
import Animate from "../ui/Animate.astro";
import { texts } from "../../content/texts";

const { comparative } = texts;
---

<section id="comparativa" class="comparative">
  <div class="container">
    <Animate animation="fade-up">
      <div class="comparative__header">
        <h2 class="comparative__title">{comparative.title}</h2>
        <p class="comparative__subtitle">{comparative.subtitle}</p>
      </div>
    </Animate>

    <Animate animation="fade-up" delay={150}>
      <div class="comparative__table-wrapper">
        <table class="comparative__table">
          <thead>
            <tr>
              <th>{comparative.headers.property}</th>
              <th>{comparative.headers.pur}</th>
              <th>{comparative.headers.pir}</th>
              <th>{comparative.headers.rock}</th>
            </tr>
          </thead>
          <tbody>
            {
              comparative.rows.map((row) => (
                <tr>
                  <td class="comparative__label">{row.label}</td>
                  <td>{row.pur}</td>
                  <td>{row.pir}</td>
                  <td>{row.rock}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Animate>
  </div>
</section>

<style>
  .comparative {
    padding-block: var(--space-20);
    background-color: var(--color-bg);
  }

  .comparative__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .comparative__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-dark);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .comparative__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  /* Table */
  .comparative__table-wrapper {
    overflow-x: auto;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .comparative__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .comparative__table thead tr {
    background-color: var(--color-primary);
  }

  .comparative__table th {
    color: white;
    font-weight: 500;
    padding: var(--space-4);
    text-align: left;
    white-space: nowrap;
  }

  .comparative__table th:first-child {
    border-radius: var(--radius-xl) 0 0 0;
  }

  .comparative__table th:last-child {
    border-radius: 0 var(--radius-xl) 0 0;
  }

  .comparative__table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    vertical-align: middle;
  }

  .comparative__table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparative__table tbody tr:hover td {
    background-color: var(--color-bg-alt);
  }

  .comparative__label {
    font-weight: 600;
    color: var(--color-dark) !important;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .comparative__title {
      font-size: var(--text-4xl);
    }
  }
</style>