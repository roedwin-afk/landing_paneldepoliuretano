---
import Animate from "../../ui/Animate.astro";
import { CheckCircle, ArrowRight } from "lucide-astro";
import { texts } from "../../../content/texts";

const { comparativa } = texts;
const { cases } = comparativa;

const tagColors: Record<string, string> = {
    blue: "tag--blue",
    orange: "tag--orange",
    red: "tag--red",
};

const lineColors: Record<string, string> = {
    blue: "line--blue",
    orange: "line--orange",
    red: "line--red",
};

const numberColors: Record<string, string> = {
    blue: "number--blue",
    orange: "number--orange",
    red: "number--red",
};
---

<section class="comparativa-cases">
    <div class="container">
        <Animate animation="fade-up">
            <div class="comparativa-cases__header">
                <h2 class="comparativa-cases__title">{cases.title}</h2>
                <p class="comparativa-cases__subtitle">{cases.subtitle}</p>
            </div>
        </Animate>

        <div class="timeline">
            {
                cases.items.map((item, i) => (
                    <Animate animation="fade-up" delay={i * 150}>
                        <div class="timeline__item">
                            <div class="timeline__aside">
                                <div
                                    class={`timeline__number ${numberColors[item.tagColor]}`}
                                >
                                    {String(i + 1).padStart(2, "0")}
                                </div>
                                {i < cases.items.length - 1 && (
                                    <div
                                        class={`timeline__line ${lineColors[item.tagColor]}`}
                                    />
                                )}
                            </div>

                            <div class="timeline__content">
                                <div class="timeline__top">
                                    <span
                                        class={`timeline__tag ${tagColors[item.tagColor]}`}
                                    >
                                        {item.tag}
                                    </span>
                                    <span class="timeline__material">
                                        <ArrowRight size={12} />
                                        {item.material}
                                    </span>
                                </div>

                                <h3 class="timeline__title">{item.title}</h3>
                                <p class="timeline__description">
                                    {item.description}
                                </p>

                                <ul class="timeline__specs">
                                    {item.specs.map((spec) => (
                                        <li class="timeline__spec">
                                            <CheckCircle size={14} />
                                            {spec}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </Animate>
                ))
            }
        </div>
    </div>
</section>

<style>
    .comparativa-cases {
        padding-block: var(--space-20);
        background-color: var(--color-bg);
    }

    .comparativa-cases__header {
        text-align: center;
        margin-bottom: var(--space-16);
    }

    .comparativa-cases__title {
        font-size: var(--text-3xl);
        font-weight: 800;
        color: var(--color-dark);
        letter-spacing: -0.02em;
        margin-bottom: var(--space-3);
    }

    .comparativa-cases__subtitle {
        font-size: var(--text-base);
        color: var(--color-text-muted);
    }

    /* Timeline */
    .timeline {
        display: flex;
        flex-direction: column;
        max-width: 100%;
    }

    .timeline__item {
        display: grid;
        grid-template-columns: 4rem 1fr;
        gap: var(--space-6);
    }

    /* Aside */
    .timeline__aside {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
    }

    .timeline__number {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-sm);
        font-weight: 800;
        flex-shrink: 0;
        letter-spacing: -0.02em;
    }

    .number--blue {
        background-color: #dbeafe;
        color: var(--color-primary);
    }

    .number--orange {
        background-color: #ffedd5;
        color: var(--color-accent);
    }

    .number--red {
        background-color: #fee2e2;
        color: #dc2626;
    }

    .timeline__line {
        width: 2px;
        flex: 1;
        min-height: var(--space-8);
        margin-block: var(--space-2);
        border-radius: 2px;
    }

    .line--blue {
        background-color: #bfdbfe;
    }

    .line--orange {
        background-color: #fed7aa;
    }

    .line--red {
        background-color: #fecaca;
    }

    /* Content */
    .timeline__content {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        padding: var(--space-8);
        box-shadow: var(--shadow-md);
        margin-bottom: var(--space-4);
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        transition: var(--transition);
    }

    .timeline__content:hover {
        transform: translateX(4px);
        box-shadow: var(--shadow-xl);
    }

    .timeline__top {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .timeline__tag {
        font-size: var(--text-xs);
        font-weight: 700;
        padding: var(--space-1) var(--space-3);
        border-radius: 9999px;
        letter-spacing: 0.05em;
    }

    .tag--blue {
        background-color: #dbeafe;
        color: var(--color-primary);
    }

    .tag--orange {
        background-color: #ffedd5;
        color: var(--color-accent);
    }

    .tag--red {
        background-color: #fee2e2;
        color: #dc2626;
    }

    .timeline__material {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .timeline__title {
        font-size: var(--text-xl);
        font-weight: 700;
        color: var(--color-dark);
        line-height: 1.3;
    }

    .timeline__description {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        line-height: 1.7;
    }

    /* Specs */
    .timeline__specs {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border);
    }

    .timeline__spec {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-sm);
        color: var(--color-text);
        font-weight: 500;
    }

    .timeline__spec svg {
        color: #16a34a;
        flex-shrink: 0;
    }

    @media (min-width: 768px) {
        .comparativa-cases__title {
            font-size: var(--text-4xl);
        }

        .timeline__item {
            grid-template-columns: 5rem 1fr;
        }
    }
    :global(.animate-wrapper) {
        display: contents;
    }
</style>
