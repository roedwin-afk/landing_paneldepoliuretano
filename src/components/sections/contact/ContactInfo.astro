---
import Animate from "../../ui/Animate.astro";
import { Phone, Mail, MapPin, Clock } from "lucide-astro";
import { texts } from "../../../content/texts";

const { contact } = texts;
const socials = [
  {
    name: "Facebook",
    href: contact.info.socials?.facebook ?? "#",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    name: "Instagram",
    href: contact.info.socials.instagram,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    name: "LinkedIn",
    href: contact.info.socials?.linkedin ?? "#",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    name: "WhatsApp",
    href:
      contact.info.socials?.whatsapp ??
      `https://wa.me/${contact.info.phone?.replace(/\D/g, "")}`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
];
---

<Animate animation="fade-left" delay={100}>
  <div class="contact-card">
    <h2 class="contact-card__title">Información de contacto</h2>
    <ul class="contact-info">
      <li class="contact-info__item">
        <span class="contact-info__icon">
          <Phone size={20} />
        </span>
        <div>
          <p class="contact-info__label">Teléfono</p>
          <a
            href={contact.info.phoneHref}
            class="contact-info__value contact-info__value--link"
          >
            {contact.info.phone}
          </a>
        </div>
      </li>

      <li class="contact-info__item">
        <span class="contact-info__icon">
          <Mail size={20} />
        </span>
        <div>
          <p class="contact-info__label">Email</p>
          <a
            href={"mailto:" + contact.info.email}
            class="contact-info__value contact-info__value--link"
          >
            {contact.info.email}
          </a>
        </div>
      </li>

      <li class="contact-info__item">
        <span class="contact-info__icon">
          <Clock size={20} />
        </span>
        <div>
          <p class="contact-info__label">Horario</p>
          <p class="contact-info__value">{contact.info.hours}</p>
        </div>
      </li>

      <li class="contact-info__item">
        <span class="contact-info__icon">
          <MapPin size={20} />
        </span>
        <div>
          <p class="contact-info__label">Dirección</p>

          <a
            href={contact.info.mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-info__value contact-info__value--link"
          >
            {contact.info.address}
          </a>
        </div>
      </li>
    </ul>
    <!-- Redes sociales -->
    <div class="contact-socials">
      <p class="contact-info__label">Síguenos</p>
      <div class="contact-socials__icons">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-socials__btn"
              aria-label={s.name}
              set:html={s.icon}
            />
          ))
        }
      </div>
    </div>
  </div>
</Animate>

<style>
  .contact-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    height: 100%;
  }

  .contact-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-info {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-info__item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .contact-info__icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    background-color: #dbeafe;
    color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-info__label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .contact-info__value {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.5;
  }

  .contact-info__value--link {
    color: var(--color-primary);
    transition: var(--transition);
  }

  .contact-info__value--link:hover {
    color: var(--color-accent);
  }

  /* Redes sociales */
  .contact-socials {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .contact-socials__icons {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .contact-socials__btn {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }

  .contact-socials__btn:hover {
    background-color: var(--color-accent);
  }
</style>
