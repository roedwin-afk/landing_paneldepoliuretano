---
import Animate from "../../ui/Animate.astro";
import { texts } from "../../../content/texts";

const { map } = texts.contact;
---

<Animate animation="fade-left" delay={200}>
  <div class="map-card">
    <div class="map-overlay" id="map-overlay">
      <span class="map-overlay__text">Toca para interactuar con el mapa</span>
    </div>
    <div id="map" class="map-card__map"></div>
  </div>
</Animate>

<style>
  .map-card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .map-overlay {
    position: absolute;
    inset: 0;
    z-index: 1000;
    background-color: rgb(0 0 0 / 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .map-overlay.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .map-overlay__text {
    background-color: white;
    color: var(--color-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .map-card__map {
    height: 24rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .map-overlay {
      display: none; /* solo en móvil */
    }
  }

  @media (min-width: 1024px) {
    .map-card__map {
      height: 32rem;
    }
  }
</style>

<script
  define:vars={{
    lat: map.lat,
    lng: map.lng,
    zoom: map.zoom,
    markerColor: map.markerColor,
  }}
>
  function loadLeaflet() {
    return new Promise((resolve) => {
      if (window.L) {
        resolve(window.L);
        return;
      }

      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      document.head.appendChild(link);

      const script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.onload = () => resolve(window.L);
      document.head.appendChild(script);
    });
  }

  async function initMap() {
    const mapEl = document.getElementById("map");
    if (!mapEl) return;

    // Destruir instancia anterior
    if (mapEl._leaflet_id) {
      delete mapEl._leaflet_id;
      mapEl.innerHTML = "";
    }

    const L = await loadLeaflet();

    // Esperar 300ms para que View Transitions y Animate terminen
    await new Promise((resolve) => setTimeout(resolve, 300));

    // Forzar recalculo de layout
    mapEl.style.display = "none";
    mapEl.offsetHeight; // trigger reflow
    mapEl.style.display = "";

    const leafletMap = L.map("map", {
      center: [lat, lng],
      zoom: zoom,
      scrollWheelZoom: false,
      dragging: !L.Browser.mobile,
      tap: false,
      zoomControl: true,
    });

    L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        maxZoom: 19,
      }
    ).addTo(leafletMap);

    const icon = L.divIcon({
      className: "",
      html: `<div style="
        width: 2rem;
        height: 2rem;
        background-color: ${markerColor};
        border: 3px solid white;
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
      "></div>`,
      iconSize: [32, 32],
      iconAnchor: [16, 32],
      popupAnchor: [0, -36],
    });

    L.marker([lat, lng], { icon })
      .addTo(leafletMap)
      .bindPopup(
        `<div style="font-family: Inter, sans-serif; padding: 0.25rem;">
          <strong style="color: #1e3a8a; display: block; margin-bottom: 0.25rem;">
            paneldepoliuretano.com
          </strong>
          <span style="font-size: 0.8rem; color: #64748b;">
            Av. Presidente Masaryk No. 61, Int. 901<br/>
            Polanco V Sección, CDMX
          </span>
        </div>`
      )
      .openPopup();

    // Overlay móvil
    const overlay = document.getElementById("map-overlay");
    if (overlay) {
      overlay.addEventListener("click", () => {
        overlay.classList.add("is-hidden");
        leafletMap.dragging.enable();
      });
    }

    if (L.Browser.mobile) {
      mapEl.addEventListener("touchstart", () => {
        leafletMap.dragging.enable();
      });
    }

    window.addEventListener("resize", () => leafletMap.invalidateSize());

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) leafletMap.invalidateSize();
    });

    // Múltiples invalidaciones escalonadas
    setTimeout(() => leafletMap.invalidateSize(), 50);
    setTimeout(() => leafletMap.invalidateSize(), 200);
    setTimeout(() => leafletMap.invalidateSize(), 500);
  }

  // Cubrir ambos casos: carga inicial y navegación con View Transitions
  document.addEventListener("astro:page-load", initMap);
  document.addEventListener("astro:after-swap", initMap);
</script>
