---
import Animate from "../ui/Animate.astro";
import { ArrowRight } from "lucide-astro";
import { texts } from "../../content/texts";
import { Image } from "astro:assets";

import panelSandwich from "../../assets/images/panel-sandwich-cubierta.png";
import panelFrigorifico from "../../assets/images/panel-frigorifico.png";

const { products } = texts;

const tagColors: Record<string, string> = {
  default: "tag--default",
  blue: "tag--blue",
  orange: "tag--orange",
};

const images = {
  "Panel Sandwich Cubierta": panelSandwich,
  "Panel Frigorífico PUR/PIR": panelFrigorifico,
  "Panel Lana de Roca": panelSandwich,
};
---

<section id="productos" class="products">
  <div class="container">
    <Animate animation="fade-up">
      <div class="products__header">
        <div>
          <h2 class="products__title">{products.title}</h2>
          <p class="products__subtitle">{products.subtitle}</p>
        </div>
        <!-- <button class="products__cta-thickness">
          {products.ctaThickness}
        </button> -->
      </div>
    </Animate>

    <div class="products__grid">
      {
        products.items.map((item, i) => (
          
          <Animate animation="fade-up" delay={i * 100}>
            <article class="product-card">
              <div class="product-card__image-wrapper">
                {/* <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="product-card__image"
                  loading="lazy"
                /> */}
                <Image
                  src={images[item.title]}
                  alt={item.imageAlt}
                  class="product-card__image"
                  loading="lazy" />
                <span class={`product-card__tag ${tagColors[item.tagColor]}`}>
                  {item.tag}
                </span>
              </div>
              <div class="product-card__body">
                <h3 class="product-card__title">{item.title}</h3>
                <p class="product-card__description">{item.description}</p>
                <div class="product-card__footer">
                  <span class="product-card__spec">{item.spec}</span>
                  <ArrowRight size={18} />
                </div>
              </div>
            </article>
          </Animate>
        ))
      }
    </div>
  </div>
</section>

<style>
  .products {
    padding-block: var(--space-20);
    background-color: var(--color-surface);
  }

  .products__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .products__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-dark);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .products__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .products__cta-thickness {
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 2px;
    transition: var(--transition);
  }

  .products__cta-thickness:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Grid */
  .products__grid {
    display: grid;
    gap: var(--space-8);
  }

  /* Card */
  .product-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: var(--transition);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .product-card__image-wrapper {
    position: relative;
    height: 12rem;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  /* Tags */
  .product-card__tag {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .tag--default {
    background-color: white;
    color: var(--color-text);
  }

  .tag--blue {
    background-color: white;
    color: var(--color-primary);
  }

  .tag--orange {
    background-color: white;
    color: var(--color-accent);
  }

  /* Body */
  .product-card__body {
    padding: var(--space-6);
  }

  .product-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: var(--space-2);
  }

  .product-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .product-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .product-card__footer svg {
    transition: var(--transition);
  }

  .product-card:hover .product-card__footer svg {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .products__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }

    .products__title {
      font-size: var(--text-4xl);
    }

    .products__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>