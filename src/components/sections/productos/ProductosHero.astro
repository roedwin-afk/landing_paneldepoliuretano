---
import Animate from "../../ui/Animate.astro";
import { texts } from "../../../content/texts";

const { productos } = texts;
---

<section class="productos-hero">
  <div class="container">
    <Animate animation="fade-up">
      <span class="productos-hero__badge">{productos.hero.badge}</span>
      <h1 class="productos-hero__title">{productos.hero.title}</h1>
      <p class="productos-hero__description">{productos.hero.description}</p>
    </Animate>
  </div>
</section>

<style>
  .productos-hero {
    background-color: var(--color-primary);
    padding-block: var(--space-16);
    color: white;
  }

  .productos-hero__badge {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background-color: rgb(255 255 255 / 0.15);
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: 9999px;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .productos-hero__title {
    font-size: var(--text-4xl);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .productos-hero__description {
    font-size: var(--text-lg);
    opacity: 0.8;
    max-width: 40rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .productos-hero__title {
      font-size: var(--text-5xl);
    }
  }
</style>