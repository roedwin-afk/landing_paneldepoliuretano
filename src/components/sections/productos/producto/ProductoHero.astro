---
import Animate from "../../../ui/Animate.astro";
import { Image } from "astro:assets";

import panelSandwich from "../../../../assets/images/panel-sandwich-cubierta.jpg";
import panelFrigorifico from "../../../../assets/images/panel-frigorifico.jpg";
import panelLanaDeRoca from "../../../../assets/images/panel-lana-de-roca.jpg";

type ProductTitle = "Panel Sandwich Cubierta" | "Panel Frigorífico PUR/PIR" | "Panel Lana de Roca";

interface Props {
  title: ProductTitle;
  description: string;
  image: string;
  imageAlt: string;
  tag: string;
  tagColor: string;
  highlights: readonly {
    label: string;
    value: string;
    unit: string;
  }[];
}

const { title, description, image, imageAlt, tag, tagColor, highlights } =
  Astro.props;

const tagColors: Record<string, string> = {
  default: "tag--default",
  blue: "tag--blue",
  orange: "tag--orange",
};

const images = {
  "Panel Sandwich Cubierta": panelSandwich,
  "Panel Frigorífico PUR/PIR": panelFrigorifico,
  "Panel Lana de Roca": panelLanaDeRoca,
};

console.log(title);
---

<section class="producto-hero">
  <div class="container producto-hero__inner">
    <Animate animation="fade-right">
      <div class="producto-hero__content">
        <span class={`producto-hero__tag ${tagColors[tagColor]}`}>{tag}</span>
        <h1 class="producto-hero__title">{title}</h1>
        <p class="producto-hero__description">{description}</p>

        <div class="producto-hero__highlights">
          {
            highlights.map((h) => (
              <div class="producto-hero__highlight">
                <span class="producto-hero__highlight-value">
                  {h.value}
                  <small>{h.unit}</small>
                </span>
                <span class="producto-hero__highlight-label">{h.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Animate>

    <Animate animation="fade-left" delay={150}>
      <div class="producto-hero__media">
        <div class="producto-hero__image-wrapper">
          <Image
            src={images[title]}
            alt={imageAlt}
            class="producto-hero__image"
            loading="eager"
          />
        </div>
      </div>
    </Animate>
  </div>
</section>

<style>
  .producto-hero {
    background-color: var(--color-surface);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .producto-hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  /* Tag */
  .producto-hero__tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-3);
    border-radius: 9999px;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .tag--default {
    background-color: var(--color-bg-alt);
    color: var(--color-text);
  }

  .tag--blue {
    background-color: #dbeafe;
    color: var(--color-primary);
  }

  .tag--orange {
    background-color: #ffedd5;
    color: var(--color-accent);
  }

  .producto-hero__title {
    font-size: var(--text-4xl);
    font-weight: 900;
    color: var(--color-dark);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .producto-hero__description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  /* Highlights */
  .producto-hero__highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .producto-hero__highlight {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .producto-hero__highlight-value {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .producto-hero__highlight-value small {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .producto-hero__highlight-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  /* Media */
  .producto-hero__image-wrapper {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .producto-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
  }

  @media (min-width: 1024px) {
    .producto-hero__inner {
      grid-template-columns: 1fr 1fr;
    }

    .producto-hero__title {
      font-size: var(--text-5xl);
    }
  }
</style>
