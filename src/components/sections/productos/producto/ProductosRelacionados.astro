---
import Animate from "../../../ui/Animate.astro";
import { ArrowRight } from "lucide-astro";
import { texts } from "../../../../content/texts";
import { Image } from "astro:assets";

import panelSandwich from "../../../../assets/images/panel-sandwich-cubierta.jpg";
import panelFrigorifico from "../../../../assets/images/panel-frigorifico.jpg";
import panelLanaDeRoca from "../../../../assets/images/panel-lana-de-roca.jpg";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const { productos } = texts;
const base = import.meta.env.BASE_URL;

const imageMap: Record<string, ImageMetadata> = {
  "Panel Sandwich Cubierta": panelSandwich,
  "Panel Frigorífico PUR/PIR": panelFrigorifico,
  "Panel Lana de Roca": panelLanaDeRoca,
};

const tagColors: Record<string, string> = {
  default: "tag--default",
  blue: "tag--blue",
  orange: "tag--orange",
};

const relacionados = productos.items.filter(
  (item) => item.slug !== currentSlug
);
---

<section class="relacionados">
  <div class="container">
    <Animate animation="fade-up">
      <div class="relacionados__header">
        <h2 class="relacionados__title">Otros productos</h2>
        <p class="relacionados__subtitle">
          Explore el resto de nuestra gama de paneles sandwich.
        </p>
      </div>
    </Animate>

    <div class="relacionados__grid">
      {
        relacionados.map((item, i) => (
          <Animate animation="fade-up" delay={i * 100}>
            <article class="rel-card">
              <a href={`${base}productos/${item.slug}`} class="rel-card__link">
                <div class="rel-card__image-wrapper">
                  <Image
                    src={imageMap[item.title]}
                    alt={item.imageAlt}
                    class="rel-card__image"
                    loading="lazy"
                    width={600}
                    height={400}
                  />
                  <span class={`rel-card__tag ${tagColors[item.tagColor]}`}>
                    {item.tag}
                  </span>
                </div>
                <div class="rel-card__body">
                  <h3 class="rel-card__title">{item.title}</h3>
                  <p class="rel-card__description">{item.shortDescription}</p>
                  <div class="rel-card__footer">
                    <span>Ver detalles</span>
                    <ArrowRight size={18} />
                  </div>
                </div>
              </a>
            </article>
          </Animate>
        ))
      }
    </div>
  </div>
</section>

<style>
  .relacionados {
    padding-block: var(--space-20);
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .relacionados__header {
    margin-bottom: var(--space-10);
  }

  .relacionados__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-dark);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .relacionados__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .relacionados__grid {
    display: grid;
    gap: var(--space-8);
  }

  /* Card — idéntica a product-card */
  .rel-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: var(--transition);
  }

  .rel-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .rel-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* Imagen */
  .rel-card__image-wrapper {
    position: relative;
    height: 12rem;
    overflow: hidden;
  }

  .rel-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .rel-card:hover .rel-card__image {
    transform: scale(1.05);
  }

  /* Tags */
  .rel-card__tag {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .tag--default {
    background-color: white;
    color: var(--color-text);
  }

  .tag--blue {
    background-color: white;
    color: var(--color-primary);
  }

  .tag--orange {
    background-color: white;
    color: var(--color-accent);
  }

  /* Body */
  .rel-card__body {
    padding: var(--space-6);
  }

  .rel-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: var(--space-2);
  }

  .rel-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .rel-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .rel-card__footer svg {
    transition: var(--transition);
  }

  .rel-card:hover .rel-card__footer svg {
    transform: translateX(4px);
  }

  /* Responsive: 2 columnas en desktop */
  @media (min-width: 768px) {
    .relacionados__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .relacionados__title {
      font-size: var(--text-4xl);
    }
  }
</style>