---
import Animate from "../../ui/Animate.astro";
import { ArrowRight } from "lucide-astro";
import { texts } from "../../../content/texts";
import { Image } from "astro:assets";


import panelSandwich from "../../../assets/images/panel-sandwich-cubierta.png";
import panelFrigorifico from "../../../assets/images/panel-frigorifico.png";
import panelLanaDeRoca from "../../../assets/images/panel-lana-de-roca.png";


const { productos } = texts;

const tagColors: Record<string, string> = {
    default: "tag--default",
    blue: "tag--blue",
    orange: "tag--orange",
};

const images = {
    "Panel Sandwich Cubierta": panelSandwich,
    "Panel Frigorífico PUR/PIR": panelFrigorifico,
    "Panel Lana de Roca": panelLanaDeRoca,
};

const base = import.meta.env.BASE_URL;
---

<section class="productos-grid">
    <div class="container">
        <div class="productos-grid__grid">
            {
                productos.items.map((item, i) => (
                    <Animate animation="fade-up" delay={i * 100}>
                        <a
                            href={`${base}productos/${item.slug}`}
                            class="producto-card"
                        >
                            <div class="producto-card__image-wrapper">
                                <Image
                                    src={images[item.title]}
                                    alt={item.imageAlt}
                                    class="producto-card__image"
                                    loading="lazy"
                                />
                                <span
                                    class={`producto-card__tag ${tagColors[item.tagColor]}`}
                                >
                                    {item.tag}
                                </span>
                            </div>

                            <div class="producto-card__body">
                                <div class="producto-card__highlights">
                                    {item.highlights.map((h) => (
                                        <div class="producto-card__highlight">
                                            <span class="producto-card__highlight-value">
                                                {h.value}
                                                <small>{h.unit}</small>
                                            </span>
                                            <span class="producto-card__highlight-label">
                                                {h.label}
                                            </span>
                                        </div>
                                    ))}
                                </div>

                                <h2 class="producto-card__title">
                                    {item.title}
                                </h2>
                                <p class="producto-card__description">
                                    {item.shortDescription}
                                </p>

                                <div class="producto-card__cta">
                                    <span>Ver especificaciones</span>
                                    <ArrowRight size={16} />
                                </div>
                            </div>
                        </a>
                    </Animate>
                ))
            }
        </div>
    </div>
</section>

<style>
    .productos-grid {
        padding-block: var(--space-20);
        background-color: var(--color-bg);
    }

    .productos-grid__grid {
        display: grid;
        gap: var(--space-8);
    }

    /* Card */
    .producto-card {
        display: block;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        transition: var(--transition);
        text-decoration: none;
        height: 100%;
    }

    .producto-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-xl);
        border-color: var(--color-primary);
    }

    /* Image */
    .producto-card__image-wrapper {
        position: relative;
        height: 14rem;
        overflow: hidden;
    }

    .producto-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .producto-card:hover .producto-card__image {
        transform: scale(1.05);
    }

    .producto-card__tag {
        position: absolute;
        top: var(--space-4);
        left: var(--space-4);
        font-size: var(--text-xs);
        font-weight: 700;
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-sm);
        letter-spacing: 0.05em;
    }

    .tag--default {
        background-color: white;
        color: var(--color-text);
    }

    .tag--blue {
        background-color: white;
        color: var(--color-primary);
    }

    .tag--orange {
        background-color: white;
        color: var(--color-accent);
    }

    /* Body */
    .producto-card__body {
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    /* Highlights */
    .producto-card__highlights {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-2);
        padding-bottom: var(--space-4);
        border-bottom: 1px solid var(--color-border);
    }

    .producto-card__highlight {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--space-1);
    }

    .producto-card__highlight-value {
        font-size: var(--text-xl);
        font-weight: 800;
        color: var(--color-primary);
        line-height: 1;
    }

    .producto-card__highlight-value small {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--color-text-muted);
    }

    .producto-card__highlight-label {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-align: center;
        line-height: 1.3;
    }

    .producto-card__title {
        font-size: var(--text-xl);
        font-weight: 700;
        color: var(--color-dark);
        line-height: 1.3;
    }

    .producto-card__description {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        line-height: 1.6;
    }

    .producto-card__cta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-sm);
        font-weight: 700;
        color: var(--color-primary);
        margin-top: auto;
        transition: var(--transition);
    }

    .producto-card:hover .producto-card__cta {
        gap: var(--space-3);
    }

    @media (min-width: 768px) {
        .productos-grid__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
