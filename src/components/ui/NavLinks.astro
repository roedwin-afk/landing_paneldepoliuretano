---
import { texts } from "../../content/texts";

interface Props {
  variant?: "navbar" | "footer" | "mobile";
}

const { variant = "navbar" } = Astro.props;

const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}comparativa`, label: texts.nav.comparative },
  { href: `${base}productos`, label: texts.nav.products },
  { href: `${base}blog`, label: texts.nav.blog },
];
---

<ul class={`nav-links nav-links--${variant}`} role="list">
  {
    links.map((link) => (
      <li>
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links {
    list-style: none;
  }

  /* Navbar */
  .nav-links--navbar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-links--navbar .nav-link {
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    transition: var(--transition);
  }

  .nav-links--navbar .nav-link:hover {
    color: var(--color-accent);
  }

  /* Footer */
  .nav-links--footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-links--footer .nav-link {
    font-size: var(--text-sm);
    color: var(--color-dark-muted);
    transition: var(--transition);
  }

  .nav-links--footer .nav-link:hover {
    color: white;
  }

  /* Mobile */
  .nav-links--mobile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-links--mobile .nav-link {
    display: block;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    transition: var(--transition);
  }

  .nav-links--mobile .nav-link:hover {
    color: var(--color-accent);
    padding-left: var(--space-2);
  }
</style>