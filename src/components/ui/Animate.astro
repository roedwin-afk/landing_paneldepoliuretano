---
interface Props {
  animation?: "fade-up" | "fade-down" | "fade-left" | "fade-right" | "fade" | "zoom";
  delay?: number;
  duration?: number;
  threshold?: number;
  class?: string;
}

const {
  animation = "fade-up",
  delay = 0,
  duration = 600,
  threshold = 0.15,
  class: className = "",
} = Astro.props;
---

<div
  class={`animate-wrapper ${className}`}
  data-animation={animation}
  data-delay={delay}
  data-duration={duration}
  data-threshold={threshold}
>
  <slot />
</div>

<style>
  .animate-wrapper {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* Estados iniciales por animación */
  .animate-wrapper[data-animation="fade-up"] {
    transform: translateY(2rem);
  }

  .animate-wrapper[data-animation="fade-down"] {
    transform: translateY(-2rem);
  }

  .animate-wrapper[data-animation="fade-left"] {
    transform: translateX(2rem);
  }

  .animate-wrapper[data-animation="fade-right"] {
    transform: translateX(-2rem);
  }

  .animate-wrapper[data-animation="fade"] {
    transform: none;
  }

  .animate-wrapper[data-animation="zoom"] {
    transform: scale(0.92);
  }

  /* Estado visible — lo activa el script */
  .animate-wrapper.is-visible {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  function initAnimations() {
    const elements = document.querySelectorAll<HTMLElement>(".animate-wrapper");

    if (!elements.length) return;

    const observers = new Map<number, IntersectionObserver>();

    elements.forEach((el) => {
      const delay = Number(el.dataset.delay) || 0;
      const duration = Number(el.dataset.duration) || 600;
      const threshold = Number(el.dataset.threshold) || 0.15;

      // Aplicar duración y delay como CSS custom properties
      el.style.setProperty("--animate-duration", `${duration}ms`);
      el.style.setProperty("--animate-delay", `${delay}ms`);
      el.style.transition =
        `opacity var(--animate-duration) ease var(--animate-delay), ` +
        `transform var(--animate-duration) ease var(--animate-delay)`;

      // Reutilizar observers con el mismo threshold
      if (!observers.has(threshold)) {
        observers.set(
          threshold,
          new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const target = entry.target as HTMLElement;
                  target.classList.add("is-visible");
                  observers.get(threshold)?.unobserve(target);
                }
              });
            },
            { threshold }
          )
        );
      }

      observers.get(threshold)?.observe(el);
    });
  }

  document.addEventListener("astro:page-load", initAnimations);
</script>