---
import { BlogList } from "astro-blog-kit/components";
import { createWPClient } from "astro-blog-kit/utils";
import config from "../../../blog.config";
import Layout from "../../layouts/Layout.astro";

let posts: any[] = [];
let totalPages = 0;

try {
  const wp = createWPClient(config.wpUrl);
  const result = await wp.getPosts({ perPage: config.postsPerPage ?? 5 });
  posts = result.posts;
  totalPages = result.totalPages;
} catch {
  console.warn("WP no disponible en build");
}

const t = {
  blog: {
    tagline: "Nuestro Blog",
    title_line1: "Últimos",
    title_line2: "Artículos",
    description: "Bienvenido a nuestro blog.",
    btncta: "Leer más",
    btn_prev: "Anterior",
    btn_next: "Siguiente",
  },
};

const base = import.meta.env.BASE_URL;
---

<Layout>
  <BlogList
    posts={posts}
    currentPage={1}
    totalPages={totalPages}
    basePath={`${base}blog/page/`}
    blogBase={`${base}blog/`}
    dateLocale={config.locale ?? "en"}
    t={t}
    locale={config.locale ?? "en"}
    layout={config.defaultLayout ?? "magazine"}
  />
</Layout>