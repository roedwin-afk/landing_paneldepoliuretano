---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/sections/CTASection.astro";
import ComparativaHero from "../components/sections/comparativa/ComparativaHero.astro";
import ComparativaTable from "../components/sections/comparativa/ComparativaTable.astro";
import ComparativaCharts from "../components/sections/comparativa/ComparativaCharts.astro";
import ComparativaGuide from "../components/sections/comparativa/ComparativaGuide.astro";
import ComparativaCases from "../components/sections/comparativa/ComparativaCases.astro";
import { texts } from "../content/texts";

const { comparativa } = texts;
---

<Layout
  title={comparativa.meta.title}
  description={comparativa.meta.description}
>
  <main>
    <ComparativaHero />
    <ComparativaTable />
    <ComparativaCharts />
    <ComparativaGuide />
    <ComparativaCases />
    <CTASection />
  </main>
</Layout>