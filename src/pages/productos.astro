---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import CTASection from "../components/sections/CTASection.astro";
import ProductosHero from "../components/sections/productos/ProductosHero.astro";
import ProductosGrid from "../components/sections/productos/ProductosGrid.astro";
import { texts } from "../content/texts";

const { productos } = texts;
---

<Layout
  title={productos.meta.title}
  description={productos.meta.description}
>
  <main>
    <ProductosHero />
    <ProductosGrid />
    <CTASection />
  </main>
</Layout>